  semantic: optional

embed text

expect:
  List the diagnostic-line rules: single-space field separation, two-space indent per delegation level with
  the "- " marker stripped before parsing, message as the final unsplit field, 1-based line/column numbers,
  "/" as the semantic path root, secondary locations as separate info-severity lines, and extension codes
  using their own MDS-E### namespace with required provenance tags.

validate:
  semantic: optional

